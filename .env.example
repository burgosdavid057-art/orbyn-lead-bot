# --- Telegram ---
# Token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxxxxx
# Token secreto que TU eliges (cadena aleatoria larga). Telegram lo enviara en el header
# X-Telegram-Bot-Api-Secret-Token de cada webhook. Sirve para validar que el request viene de Telegram.
TELEGRAM_WEBHOOK_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# --- LLM (Groq, gratis y rapidisimo) ---
# Conseguir en https://console.groq.com/keys (login con Google, sin tarjeta)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Sheets ---
# ID de la hoja: copialo de la URL https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890
# Nombre de la pestania dentro de la hoja
GOOGLE_SHEET_TAB=Leads
# Ruta al archivo JSON del Service Account descargado desde Google Cloud
GOOGLE_CREDENTIALS_PATH=./google-credentials.json

# --- App ---
# Tamano maximo del texto del lead aceptado (defensa contra abuso/prompt injection)
MAX_LEAD_LENGTH=2000
# Habilita logs verbosos en consola
DEBUG=false
